struct TransformStore {
    xs: List<Float>
    ys: List<Float>
}
struct VelocityStore {
    vxs: List<Float>
    vys: List<Float>
}
struct EcsWorld {
    count: Int
    transforms: TransformStore
    velocities: VelocityStore
}
fn create_world(n: Int) -> EcsWorld {
    val xs: List<Float> = []
    val ys: List<Float> = []
    val vxs: List<Float> = []
    val vys: List<Float> = []
    mut i = 0
    while i < n {
        val fi = str_to_float(int_to_str(i))
        xs.append(fi * 2.0)
        ys.append(fi * -1.5)
        vxs.append(0.5 + (fi * 0.01))
        vys.append(-0.25 + (fi * 0.005))
        i = i + 1
    }
    val t = TransformStore { xs: xs, ys: ys }
    val v = VelocityStore { vxs: vxs, vys: vys }
    return EcsWorld { count: n, transforms: t, velocities: v }
}
fn physics_step(world: EcsWorld, dt: Float) -> EcsWorld {
    val new_xs: List<Float> = []
    val new_ys: List<Float> = []
    mut i = 0
    while i < world.count {
        val px = world.transforms.xs[i]
        val py = world.transforms.ys[i]
        val vx = world.velocities.vxs[i]
        val vy = world.velocities.vys[i]
        new_xs.append(px + vx * dt)
        new_ys.append(py + vy * dt)
        i = i + 1
    }
    val t = TransformStore { xs: new_xs, ys: new_ys }
    return EcsWorld {
        count: world.count
        transforms: t
        velocities: world.velocities
    }
}
fn main() {
    let fixed_dt: Float = 16.666667
    let fixed_dt_sec: Float = 0.016666667
    mut world = create_world(16)
    mut accumulator: Float = 0.0
    mut ticks_simulated: Int = 0
    mut frame: Int = 0
    while frame < 60 {
        accumulator = accumulator + 20.0
        while accumulator >= fixed_dt {
            world = physics_step(world, fixed_dt_sec)
            accumulator = accumulator - fixed_dt
            ticks_simulated = ticks_simulated + 1
        }
        frame = frame + 1
    }
    out int_to_str(ticks_simulated)
}
