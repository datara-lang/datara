struct TStore { xs: List<Float>, ys: List<Float> }
struct World3 { count: Int, t: TStore }
fn make(n: Int) -> World3 {
    val xs: List<Float> = []
    val ys: List<Float> = []
    mut i = 0
    while i < n {
        val fi = str_to_float(int_to_str(i))
        xs.append(fi * 2.0)
        ys.append(fi * -1.5)
        i = i + 1
    }
    val t = TStore { xs: xs, ys: ys }
    return World3 { count: n, t: t }
}
fn main() {
    val n = 4
    val w = make(n)
    out int_to_str(w.count)
    out float_to_str(w.t.xs[0])
    out float_to_str(w.t.ys[1])
    out "TWO-LISTS-OK"
}
