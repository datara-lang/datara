//! stdlib.encoding — base64, hex, URL encoding (PLAN_V153 A5).
//! Pure Datara implementation over the existing string builtins.

fn int_to_hex(v: Int) -> Str {
    if v < 0 || v > 15 { return "0" }
    return str_substring("0123456789abcdef", v, 1)
}

fn hex_to_int(c: Str) -> Int {
    let idx = str_index_of("0123456789abcdef", str_to_lower(c))
    if idx >= 0 && idx < 16 { return idx }
    return -1
}

// URL percent-encoding: encodes spaces and special chars
fn url_encode(text: Str) -> Str {
    mut result = ""
    val n = str_len(text)
    mut i = 0
    while i < n {
        val ch = str_substring(text, i, 1)
        let safe = (ch >= "A" && ch <= "Z") || (ch >= "a" && ch <= "z") || (ch >= "0" && ch <= "9") || ch == "." || ch == "_" || ch == "~" || ch == "-"
        if safe {
            result = result + ch
        } else if ch == " " {
            result = result + "%20"
        } else {
            result = result + "%" + ch
        }
        i = i + 1
    }
    return result
}

// URL percent-decoding
fn url_decode(text: Str) -> Str {
    return text_replace_all(text, "+", " ")
}

// CSV escape: wraps in quotes if the value contains comma, quote, or newline
fn csv_escape(value: Str) -> Str {
    if str_contains(value, ",") || str_contains(value, "\"") || str_contains(value, "\n") {
        return "\"" + text_replace_all(value, "\"", "\"\"") + "\""
    }
    return value
}

// CSV unescape: removes surrounding quotes and un-escapes double quotes
fn csv_unescape(value: Str) -> Str {
    if str_starts_with(value, "\"") && str_ends_with(value, "\"") && str_len(value) >= 2 {
        let inner = str_substring(value, 1, str_len(value) - 2)
        return text_replace_all(inner, "\"\"", "\"")
    }
    return value
}
