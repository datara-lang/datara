struct StringUtils {
    prefix: Str
}

behavior StringUtils {
    wrap_brackets(content: Str) -> Str {
        return "[" + content + "]"
    }

    quote(content: Str) -> Str {
        return "'" + content + "'"
    }

    contains(s: Str, sub: Str) -> Bool {
        val res = str_contains(s, sub)
        return res == 1
    }

    starts_with(s: Str, prefix: Str) -> Bool {
        val res = str_starts_with(s, prefix)
        return res == 1
    }

    ends_with(s: Str, suffix: Str) -> Bool {
        val res = str_ends_with(s, suffix)
        return res == 1
    }

    index_of(s: Str, sub: Str) -> Int {
        return str_index_of(s, sub)
    }

    trim(s: Str) -> Str {
        return str_trim(s)
    }

    to_int(s: Str) -> Int {
        return str_to_int(s)
    }

    repeat(s: Str, count: Int) -> Str {
        return str_repeat(s, count)
    }

    pad_left(s: Str, total_len: Int, pad: Str) -> Str {
        return str_pad_left(s, total_len, pad)
    }

    pad_right(s: Str, total_len: Int, pad: Str) -> Str {
        return str_pad_right(s, total_len, pad)
    }

    replace(s: Str, target: Str, replacement: Str) -> Str {
        return str_replace(s, target, replacement)
    }

    to_upper(s: Str) -> Str {
        return str_to_upper(s)
    }

    to_lower(s: Str) -> Str {
        return str_to_lower(s)
    }

    split(s: Str, delim: Str) -> List<Str> {
        return str_split(s, delim)
    }

    join(items: List<Str>, delim: Str) -> Str {
        return str_join(items, delim)
    }

    // --- M1 canonical text API (PLAN_V150) -------------------------------
    // find/slice/len operate on CODEPOINTS, not bytes: the runtime
    // translates codepoint indices to byte offsets internally, so
    // "привет".slice(0, 2) is "пр" and find() reports codepoint positions.
    // The raw str_index_of/str_substring builtins stay byte-based for
    // low-level use.

    /// First index of `sub` in `s` as a CODEPOINT index, or -1.
    find(s: Str, sub: Str) -> Int {
        val byte_pos = str_index_of(s, sub)
        if byte_pos < 0 {
            return -1
        }
        return str_byte_to_cp(s, byte_pos)
    }

    /// Codepoint slice `[start, start+len)` clamped to the string bounds.
    slice(s: Str, start: Int, len: Int) -> Str {
        return str_substring_cp(s, start, len)
    }

    /// Codepoint length of the string (decoded UTF-8).
    len(s: Str) -> Int {
        return str_chars(s)
    }
}
