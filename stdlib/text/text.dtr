//! stdlib.text.text — checked parsing and UTF-8-aware free functions.
//!
//! Thin Datara wrappers over the compiler/runtime primitives, in the same
//! free-function style as stdlib.sys:
//!   text_parse_int(s)    -> Outcome<Int>   -- `or`-friendly integer parse.
//!   text_parse_float(s)  -> Outcome<Float> -- `or`-friendly float parse.
//!   text_to_int(s)       -> Int            -- unchecked parse (0 on garbage).
//!   text_to_float(s)     -> Float          -- unchecked parse (0.0 on garbage).
//!   text_is_int(s)       -> Bool
//!   text_is_float(s)     -> Bool
//!   text_char_len(s)     -> Int            -- codepoint length (decoded UTF-8).
//!   text_scalar_at(s, i) -> Str            -- i-th CODEPOINT as a string.
//!   text_slice_cp(s, start, len) -> Str    -- codepoint-bounded slice, clamped.
//!   text_validate(s)     -> Bool           -- strict UTF-8 validation.
//!   text_sanitize(s)     -> Str            -- replace invalid sequences with U+FFFD.
//!
//! The generic Outcome accessors (`or`, `?`, is_ok/unwrap/err) come from
//! stdlib.result; the parser wrappers are registered with the driver's
//! auto-loader so using them with `or`/`?` never hits E0944.
//!
//! NOTE: bare `parse_int`/`parse_float` builtins remain the low-level entry
//! points; the text_* names are the stdlib-canonical spellings.

fn text_parse_int(s: Str) -> Outcome<Int> {
    return parse_int(s)
}

fn text_parse_float(s: Str) -> Outcome<Float> {
    return parse_float(s)
}

fn text_to_int(s: Str) -> Int {
    return str_to_int(s)
}

fn text_to_float(s: Str) -> Float {
    return str_to_float(s)
}

fn text_is_int(s: Str) -> Bool {
    val r = parse_int(s)
    return r.is_ok()
}

fn text_is_float(s: Str) -> Bool {
    val r = parse_float(s)
    return r.is_ok()
}

fn text_char_len(s: Str) -> Int {
    return str_chars(s)
}

fn text_scalar_at(s: Str, index: Int) -> Str {
    return str_scalar_at(s, index)
}

//! text_char_at_cp(s, i) -> Str
//! CODEPOINT-indexed single-character access (text_scalar_at above takes a
//! BYTE offset into the string — the raw runtime contract). This wrapper
//! translates the codepoint index via the codepoint->byte translation and
//! returns exactly one character.

fn text_slice_cp(s: Str, start: Int, len: Int) -> Str {
    return str_substring_cp(s, start, len)
}

fn text_char_at_cp(s: Str, index: Int) -> Str {
    return str_scalar_at_cp(s, index)
}

fn text_validate(s: Str) -> Bool {
    return validate_utf8(s)
}

fn text_sanitize(s: Str) -> Str {
    return str_sanitize_utf8(s)
}

//! text_is_blank(s) -> Bool
//! True when the string is empty or consists only of whitespace.
fn text_is_blank(s: Str) -> Bool {
    val trimmed = str_trim(s)
    return trimmed == ""
}

//! text_count_char(s, ch) -> Int
//! Occurrences of the single CODEPOINT `ch` in `s` (Cyrillic/CJK-safe:
//! walks the string codepoint-by-codepoint, so it never matches inside
//! a multi-byte sequence).
fn text_count_char(s: Str, ch: Str) -> Int {
    mut count = 0
    mut i = 0
    val n = str_chars(s)
    while i < n {
        if str_substring_cp(s, i, 1) == ch {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

//! text_starts_utf8(s, prefix) -> Bool
//! Codepoint-safe startswith (prefix search itself stays byte-based:
//! a UTF-8 prefix match at offset 0 is boundary-safe by construction).
fn text_starts_utf8(s: Str, prefix: Str) -> Bool {
    return str_starts_with(s, prefix)
}

//! text_pad_left_cp / text_pad_right_cp: codepoint-aware padding. The raw
//! str_pad_* builtins are byte-length-based, so padding a Cyrillic string to
//! width N would overshoot; these measure the visible width in codepoints.
fn text_pad_left_cp(s: Str, width: Int, pad: Str) -> Str {
    val visible = str_chars(s)
    if visible >= width {
        return s
    }
    val fill = str_repeat(pad, width - visible)
    return fill + s
}

fn text_pad_right_cp(s: Str, width: Int, pad: Str) -> Str {
    val visible = str_chars(s)
    if visible >= width {
        return s
    }
    val fill = str_repeat(pad, width - visible)
    return s + fill
}

//! text_split_n(s, sep, max_parts) -> List<Str>
//! Split with a maximum number of parts (the last part contains the rest).
fn text_split_n(s: Str, sep: Str, max_parts: Int) -> List<Str> {
    val parts = str_split(s, sep)
    val n = parts.len()
    if n <= max_parts { return parts }
    mut result = []
    mut i = 0
    while i < max_parts - 1 {
        result = result.push(parts.get(i))
        i = i + 1
    }
    mut rest = ""
    while i < n {
        if i > max_parts - 1 { rest = rest + sep }
        rest = rest + parts.get(i)
        i = i + 1
    }
    result = result.push(rest)
    return result
}

//! text_trim_start(s) -> Str — strip leading whitespace
fn text_trim_start(s: Str) -> Str {
    val n = str_len(s)
    mut start = 0
    while start < n {
        val ch = str_scalar_at_cp(s, start)
        if ch != " " && ch != "\t" && ch != "\n" && ch != "\r" { break }
        start = start + 1
    }
    return str_substring(s, start, n - start)
}

//! text_trim_end(s) -> Str — strip trailing whitespace
fn text_trim_end(s: Str) -> Str {
    val n = str_len(s)
    mut end = n
    while end > 0 {
        val ch = str_scalar_at_cp(s, end - 1)
        if ch != " " && ch != "\t" && ch != "\n" && ch != "\r" { break }
        end = end - 1
    }
    return str_substring(s, 0, end)
}

//! text_lines(s) -> List<Str> — split by newlines, skipping empty lines
fn text_lines(s: Str) -> List<Str> {
    val all = str_split(s, "\n")
    mut result = []
    val n = all.len()
    mut i = 0
    while i < n {
        val line = all.get(i)
        if str_len(line) > 0 {
            result = result.push(line)
        }
        i = i + 1
    }
    return result
}

//! text_repeat(s, count) -> Str — repeat a string count times
fn text_repeat(s: Str, count: Int) -> Str {
    mut acc = ""
    mut i = 0
    while i < count {
        acc = acc + s
        i = i + 1
    }
    return acc
}

//! text_replace_all(s, old, new) -> Str — replace all occurrences
fn text_replace_all(s: Str, old: Str, new: Str) -> Str {
    mut acc = ""
    val s_len = str_len(s)
    val old_len = str_len(old)
    mut i = 0
    while i < s_len {
        if old_len > 0 && i + old_len <= s_len {
            val sub = str_substring(s, i, old_len)
            if sub == old {
                acc = acc + new
                i = i + old_len
                continue
            }
        }
        val ch = str_scalar_at_cp(s, i)
        acc = acc + ch
        i = i + 1
    }
    return acc
}
