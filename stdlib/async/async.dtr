//! stdlib.async — non-blocking sleep and batch-wait wrappers (PLAN_V152 N3).
//! The fiber_spawn/join builtins already provide the core async story;
//! this module adds convenience wrappers that don't need fn-pointer args.
//!
//! Usage:
//!   fn main() {
//!       async_sleep_ms(100)  // parks this fiber, others run
//!       val done = async_wait_all()  // wait for all spawned fibers
//!   }

// Sleep without blocking other fibers (non-blocking timer-wheel park).
fn async_sleep_ms(ms: Int) {
    fiber_sleep_ms(ms)
}

// Wait for ALL spawned fibers to finish, return the done count.
fn async_wait_all() -> Int {
    return fiber_run_until_done()
}

// Yield control to the scheduler (round-robin).
fn async_yield() {
    fiber_yield()
}

// ============================================================================
// FiberHandle (PLAN_V152 N1.3): an object view over a spawned fiber.
// Values cross fibers through channels (fiber_join carries the exit code
// only); the handle adds non-blocking completion polling.
//
//   val h = fiber_handle(fiber_spawn(worker, 1))
//   ...inside another fiber (or after a yield):
//   if h.is_done() { val code = h.join() }
// ============================================================================

struct FiberHandle {
    handle: Int
}

behavior FiberHandle {
    // Non-blocking: true once the fiber has finished (scheduler-driven).
    is_done() -> Bool {
        return fiber_is_done(this.handle)
    }

    // Blocking join: parks this fiber until the target is DONE, then
    // returns the target's exit code.
    join() -> Int {
        return fiber_join(this.handle)
    }
}

// Wraps an existing spawn handle into a FiberHandle.
fn fiber_handle(handle: Int) -> FiberHandle {
    return FiberHandle { handle: handle }
}
