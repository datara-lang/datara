//! stdlib.sys — process environment, arguments, and command execution.
//!
//! Thin Datara wrappers over the compiler/runtime primitives:
//!   sys_args() -> List<Str>          -- program arguments (argv[1..]).
//!   sys_env(key) -> Outcome<Str>     -- `or`-friendly env lookup (checked).
//!   sys_env_get(key) -> Str          -- unchecked lookup ("" when missing).
//!   sys_env_set(key, val) -> Bool    -- set/update a variable.
//!   sys_exec(cmd) -> Outcome<Str>    -- run a command, capture stdout (UTF-8);
//!                                        `or`-friendly (checked exec).
//!   proc_spawn(cmd) -> Outcome<Int>  -- fire-and-forget child (PID).
//!   proc_run_input(cmd, input) -> Outcome<Str>
//!                                        pipe `input` into the child's stdin,
//!                                        capture merged stdout+stderr.
//!   proc_wait(pid) -> Outcome<Int>   -- reap a spawned child (exit code).
//!
//! `sys_exec` and `env_get` are capability-guarded by the security verifier
//! (E0940/E-CAP-001): declare `env = [...]` / `exec = [...]` in datara.toml.

fn sys_args() -> List<Str> {
    // argv[0] is the host binary name ("forgen"); the documented
    // contract is the program's own arguments, so skip it.
    val n = args_count()
    mut acc: List<Str> = []
    mut i = 1
    while i < n {
        acc.push(args_get(i))
        i = i + 1
    }
    return acc
}

fn sys_env(key: Str) -> Outcome<Str> {
    return env_get_checked(key)
}

fn sys_env_get(key: Str) -> Str {
    return env_get(key)
}

fn sys_env_set(key: Str, value: Str) -> Bool {
    val res = env_set(key, value)
    return res == 1
}

fn sys_exec(cmd: Str) -> Outcome<Str> {
    // exec is an escalated op: manifest declaration alone is not enough,
    // the security verifier also demands an explicit unsafe justification.
    unsafe(justification: "sys_exec forwards an escalated exec_utf8 call; the caller opts in via [capabilities] exec + this wrapper's justification") {
        return exec_utf8(cmd)
    }
}

// v1.5.0 (M1): process spawn / pipes / wait.
//   proc_spawn(cmd) -> Outcome<Int>      fire-and-forget child (PID handle);
//                                        inherits the parent's stdio.
//   proc_run_input(cmd, input) -> Outcome<Str>
//                                        writes `input` to the child's stdin,
//                                        captures merged stdout+stderr.
//   proc_wait(pid) -> Outcome<Int>       reap a spawned child, yield its exit
//                                        code.
// All three are escalated ops ([capabilities] exec + unsafe justification).
fn proc_spawn(cmd: Str) -> Outcome<Int> {
    unsafe(justification: "proc_spawn forwards an escalated process spawn; the caller opts in via [capabilities] exec + this wrapper's justification") {
        return datara_rt_proc_spawn(cmd)
    }
}

fn proc_run_input(cmd: Str, input: Str) -> Outcome<Str> {
    unsafe(justification: "proc_run_input forwards an escalated piped process run; the caller opts in via [capabilities] exec + this wrapper's justification") {
        return datara_rt_proc_run_input(cmd, input)
    }
}

fn proc_wait(pid: Int) -> Outcome<Int> {
    unsafe(justification: "proc_wait forwards an escalated process wait; the caller opts in via [capabilities] exec + this wrapper's justification") {
        return datara_rt_proc_wait(pid)
    }
}
