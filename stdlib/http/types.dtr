struct HttpRequest {
    method: Str
    path: Str
    headers: Str
    body: Str
    query: Str
}

behavior HttpRequest {
    parse(raw: Str) -> HttpRequest {
        // request line: METHOD SP TARGET SP HTTP/1.x
        // target: /path?query=val&x=y  — query is split off
        let line_end = str_index_of(raw, "\r\n")
        let line = if line_end >= 0 {
            str_substring(raw, 0, line_end)
        } else {
            str_trim(raw)
        }
        let sp1 = str_index_of(line, " ")
        let method = if sp1 > 0 {
            str_substring(line, 0, sp1)
        } else {
            "GET"
        }
        let rest = if sp1 > 0 {
            str_substring(line, sp1 + 1, str_len(line) - sp1 - 1)
        } else {
            "/"
        }
        let sp2 = str_index_of(rest, " ")
        let target = if sp2 >= 0 {
            str_substring(rest, 0, sp2)
        } else {
            rest
        }
        let q = str_index_of(target, "?")
        let path = if q >= 0 {
            str_substring(target, 0, q)
        } else {
            target
        }
        let query = if q >= 0 {
            str_substring(target, q + 1, str_len(target) - q - 1)
        } else {
            ""
        }
        let body_idx = str_index_of(raw, "\r\n\r\n")
        let body = if body_idx >= 0 {
            str_substring(raw, body_idx + 4, str_len(raw) - body_idx - 4)
        } else {
            ""
        }
        return HttpRequest {
            method: method,
            path: path,
            headers: raw,
            body: body,
            query: query
        }
    }
}

struct HttpResponse {
    status: Int
    headers: Str
    body: Str
}

behavior HttpResponse {
    ok(body: Str) -> HttpResponse {
        return HttpResponse {
            status: 200,
            headers: "Content-Type: text/plain\r\n",
            body: body
        }
    }

    json(json_str: Str) -> HttpResponse {
        return HttpResponse {
            status: 200,
            headers: "Content-Type: application/json\r\n",
            body: json_str
        }
    }

    not_found() -> HttpResponse {
        return HttpResponse {
            status: 404,
            headers: "Content-Type: text/plain\r\n",
            body: "404 Not Found"
        }
    }

    to_raw() -> Str {
        mut status_line = "HTTP/1.1 200 OK\r\n"
        if this.status == 404 {
            status_line = "HTTP/1.1 404 Not Found\r\n"
        }
        if this.status == 500 {
            status_line = "HTTP/1.1 500 Internal Server Error\r\n"
        }
        
        let full = status_line + this.headers + "Connection: close\r\n\r\n" + this.body
        return full
    }
}
