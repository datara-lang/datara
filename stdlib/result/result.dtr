class Outcome<T> {
    is_success: Bool
    value: T
    error_msg: Str
}

behavior Outcome {
    is_ok() -> Bool {
        return this.is_success
    }

    is_err() -> Bool {
        return !this.is_success
    }

    unwrap() -> T {
        // Trapping unwrap: on the err state there is no valid payload (the
        // value slot is 0 by the two-state convention), so handing it back
        // would silently move pointer garbage downstream. Abort through the
        // runtime panic path with the stored message instead.
        if !this.is_success {
            panic(this.error_msg)
        }
        return this.value
    }

    unwrap_or(default_val: T) -> T {
        if this.is_success {
            return this.value
        }
        return default_val
    }

    // Error channel accessor: "" when ok (the two-state convention keeps
    // error_msg empty on the ok state), the stored message when err.
    err() -> Str {
        if this.is_success {
            return ""
        }
        return this.error_msg
    }
}
