//! stdlib.json.reader — recursive-descent JSON validator (PLAN_V152 N3,
//! "парсер-добивка"). Unlike parser.dtr (per-key substring scan), this module
//! walks the ENTIRE document byte-by-byte with the full JSON grammar
//! (RFC 8259): objects, arrays, strings with escapes, numbers, literals.
//!
//! Design constraints discovered on the current tiers (each recorded as a
//! repro in PLAN_V152 N2):
//!   1. str_byte_at re-runs strlen per call — O(n^2) on large documents.
//!      The document is converted ONCE via str_bytes() into a List<Int>
//!      with O(1) indexed access.
//!   2. Module-level mutable state inside a use'd module does not persist
//!      across function calls (per-function isolation) — so this parser is
//!      PURE: every production takes the byte list + cursor + depth and
//!      returns the new cursor. Success: >= 0 (bytes consumed). Failure:
//!      a negative error code encoding kind and byte position (see
//!      json_error_text).
//!
//! Usage:
//!   use stdlib.json.reader
//!   val rc = json_validate(text)       // >= 0 valid, < 0 syntax error
//!   if rc < 0 { out json_error_text(rc) }
//!
//! The bench workload for this module lives in bench_json/ (10 MB vs C).

// NOTE: the error encoding uses the literal 1000000000 instead of a module
// const on purpose — a module-level `const` inside a use'd module lowers
// to 0 at run time on the current tiers (repro recorded in PLAN_V152 N2).

// Validates `text` against the full JSON grammar.
// Returns >= 0 (bytes consumed = document length) on success; on failure
// returns -(kind * JERR_SCALE + byte_pos). Decode with json_error_kind /
// json_error_pos / json_error_text.
fn json_validate(text: Str) -> Int {
    val b = str_bytes(text)
    val rc = r_parse_value(b, 0, 0)
    if rc < 0 {
        return rc
    }
    val end = r_skip_ws(b, rc)
    if end != b.len() {
        return -(14000000000 + end)
    }
    return end
}

// Error kind of a json_validate failure code (1..=14, see json_error_text).
fn json_error_kind(rc: Int) -> Int {
    // 1000000000 == JERR_SCALE; written as a literal because the E0941
    // prover accepts only literal/require-refined divisors.
    require 1000000000 != 0
    if rc < 0 {
        return (-rc) / 1000000000
    }
    return 0
}

// Byte position of a json_validate failure.
fn json_error_pos(rc: Int) -> Int {
    require 1000000000 != 0
    if rc < 0 {
        return (-rc) % 1000000000
    }
    return 0
}

// Human-readable description of a json_validate failure code.
// Kinds: 1 unexpected byte, 2 bad literal, 3 unterminated string,
// 4 control byte in string, 5 bad escape, 6 bad u-escape, 7 digit expected,
// 8 leading zero, 9 digit after dot expected, 10 bad exponent,
// 11 expected colon, 12 expected comma/close, 13 depth limit,
// 14 trailing content.
fn json_error_text(rc: Int) -> Str {
    if rc >= 0 {
        return "no error"
    }
    val kind = json_error_kind(rc)
    val pos = json_error_pos(rc)
    if kind == 1 {
        return fmt"unexpected byte at {pos}"
    }
    if kind == 2 {
        return fmt"bad literal at {pos}"
    }
    if kind == 3 {
        return fmt"unterminated string at {pos}"
    }
    if kind == 4 {
        return fmt"control byte in string at {pos}"
    }
    if kind == 5 {
        return fmt"bad escape at {pos}"
    }
    if kind == 6 {
        return fmt"bad u-escape at {pos}"
    }
    if kind == 7 {
        return fmt"digit expected at {pos}"
    }
    if kind == 8 {
        return fmt"leading zero at {pos}"
    }
    if kind == 9 {
        return fmt"digit after dot expected at {pos}"
    }
    if kind == 10 {
        return fmt"bad exponent at {pos}"
    }
    if kind == 11 {
        return fmt"expected colon at {pos}"
    }
    if kind == 12 {
        return fmt"expected comma or close at {pos}"
    }
    if kind == 13 {
        return fmt"depth limit exceeded at {pos}"
    }
    return fmt"trailing content at {pos}"
}

// --- pure cursor helpers ---

fn r_peek(b: List<Int>, pos: Int) -> Int {
    if pos < b.len() {
        return b.get(pos)
    }
    return -1
}

fn r_skip_ws(b: List<Int>, pos: Int) -> Int {
    // space, tab, LF, CR
    mut p = pos
    while r_peek(b, p) == 32 || r_peek(b, p) == 9 || r_peek(b, p) == 10 || r_peek(b, p) == 13 {
        p = p + 1
    }
    return p
}

fn r_fail(kind: Int, pos: Int) -> Int {
    return -(kind * 1000000000 + pos)
}

// --- grammar productions ---
// Convention: each returns the new cursor on success, or a negative
// r_fail code on failure.

fn r_parse_value(b: List<Int>, pos: Int, depth: Int) -> Int {
    val c = r_peek(b, pos)
    // { [ " - 0-9 t f n
    if c == 123 {
        return r_parse_object(b, pos, depth)
    }
    if c == 91 {
        return r_parse_array(b, pos, depth)
    }
    if c == 34 {
        return r_parse_string(b, pos)
    }
    if c == 45 || (c >= 48 && c <= 57) {
        return r_parse_number(b, pos)
    }
    if c == 116 {
        return r_parse_lit(b, pos, "true")
    }
    if c == 102 {
        return r_parse_lit(b, pos, "false")
    }
    if c == 110 {
        return r_parse_lit(b, pos, "null")
    }
    return r_fail(1, pos)
}

fn r_parse_lit(b: List<Int>, pos: Int, word: Str) -> Int {
    val w = str_bytes(word)
    mut p = pos
    mut i = 0
    while i < w.len() {
        if r_peek(b, p) != w.get(i) {
            return r_fail(2, p)
        }
        p = p + 1
        i = i + 1
    }
    return p
}

// Validates a JSON string body including escapes (\" \\ \/ \b \f \n \r \t
// \uXXXX); raw control bytes below 0x20 are rejected.
fn r_parse_string(b: List<Int>, pos: Int) -> Int {
    if r_peek(b, pos) != 34 {
        return r_fail(1, pos)
    }
    mut p = pos + 1
    while r_peek(b, p) != 34 {
        val c = r_peek(b, p)
        if c < 0 {
            return r_fail(3, p)
        }
        if c < 32 {
            return r_fail(4, p)
        }
        if c == 92 {
            p = p + 1
            val e = r_peek(b, p)
            if e == 117 {
                // \uXXXX: exactly 4 hex digits
                p = p + 1
                mut k = 0
                while k < 4 {
                    val h = r_peek(b, p)
                    if !((h >= 48 && h <= 57) || (h >= 65 && h <= 70) || (h >= 97 && h <= 102)) {
                        return r_fail(6, p)
                    }
                    p = p + 1
                    k = k + 1
                }
            } else {
                // " \ / b f n r t
                if e == 34 || e == 92 || e == 47 || e == 98 || e == 102 || e == 110 || e == 114 || e == 116 {
                    p = p + 1
                } else {
                    return r_fail(5, p)
                }
            }
        } else {
            p = p + 1
        }
    }
    return p + 1
}

// Strict JSON number: -?(0|[1-9][0-9]*)(.[0-9]+)?([eE][+-]?[0-9]+)?
fn r_parse_number(b: List<Int>, pos: Int) -> Int {
    mut p = pos
    if r_peek(b, p) == 45 {
        p = p + 1
    }
    val d = r_peek(b, p)
    if d < 48 || d > 57 {
        return r_fail(7, p)
    }
    if d == 48 {
        p = p + 1
        val n = r_peek(b, p)
        if n >= 48 && n <= 57 {
            return r_fail(8, p)
        }
    } else {
        while r_peek(b, p) >= 48 && r_peek(b, p) <= 57 {
            p = p + 1
        }
    }
    if r_peek(b, p) == 46 {
        p = p + 1
        if r_peek(b, p) < 48 || r_peek(b, p) > 57 {
            return r_fail(9, p)
        }
        while r_peek(b, p) >= 48 && r_peek(b, p) <= 57 {
            p = p + 1
        }
    }
    val e = r_peek(b, p)
    if e == 101 || e == 69 {
        p = p + 1
        val s = r_peek(b, p)
        if s == 43 || s == 45 {
            p = p + 1
        }
        if r_peek(b, p) < 48 || r_peek(b, p) > 57 {
            return r_fail(10, p)
        }
        while r_peek(b, p) >= 48 && r_peek(b, p) <= 57 {
            p = p + 1
        }
    }
    return p
}

fn r_parse_object(b: List<Int>, pos: Int, depth: Int) -> Int {
    if depth > 128 {
        return r_fail(13, pos)
    }
    mut p = pos + 1
    p = r_skip_ws(b, p)
    if r_peek(b, p) == 125 {
        return p + 1
    }
    while true {
        p = r_skip_ws(b, p)
        val k = r_parse_string(b, p)
        if k < 0 {
            return k
        }
        p = r_skip_ws(b, k)
        if r_peek(b, p) != 58 {
            return r_fail(11, p)
        }
        p = r_skip_ws(b, p + 1)
        val v = r_parse_value(b, p, depth + 1)
        if v < 0 {
            return v
        }
        p = r_skip_ws(b, v)
        val c = r_peek(b, p)
        if c == 44 {
            p = p + 1
        } else if c == 125 {
            return p + 1
        } else {
            return r_fail(12, p)
        }
    }
    return r_fail(12, p)
}

fn r_parse_array(b: List<Int>, pos: Int, depth: Int) -> Int {
    if depth > 128 {
        return r_fail(13, pos)
    }
    mut p = pos + 1
    p = r_skip_ws(b, p)
    if r_peek(b, p) == 93 {
        return p + 1
    }
    while true {
        p = r_skip_ws(b, p)
        val v = r_parse_value(b, p, depth + 1)
        if v < 0 {
            return v
        }
        p = r_skip_ws(b, v)
        val c = r_peek(b, p)
        if c == 44 {
            p = p + 1
        } else if c == 93 {
            return p + 1
        } else {
            return r_fail(12, p)
        }
    }
    return r_fail(12, p)
}
