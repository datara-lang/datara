fn main() {
    mut n = 96
    mut sum = 0
    mut i = 0
    while i < n {
        mut j = 0
        while j < n {
            mut k = 0
            while k < n {
                sum = sum + i * j + k
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    print(sum)
}
