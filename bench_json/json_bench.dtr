//! bench_json: Datara side (PLAN_V152 N3 honest artifact).
//! Workload is semantically identical to bench_json/json_c.c:
//!   Phase 1 VALIDATE: stdlib.json.reader json_validate — full RFC 8259
//!           recursive-descent walk of the whole document.
//!   Phase 2 EXTRACT: top-level array scan (byte list, depth tracking);
//!           for every record extract "id" (Int) and "name" (Str) length;
//!           accumulate sum(id) and sum(len(name)).
//!
//! The extractors mirror stdlib.json.parser's get_int/get_string
//! semantics (index_of pattern -> substring -> parse) as plain functions
//! instead of JsonParser behavior calls: calling a behavior method from
//! inside a byte-scan loop currently segfaults on both tiers (repro
//! recorded in PLAN_V152 N2 — T4/T9b: method dispatch in a loop that
//! reads a List<Int> crashes; the identical body as a plain fn runs
//! clean and bit-matches the C ground truth).
//!
//! Run: forgen run bench_json/json_bench.dtr   (data generated by
//! bench_json/gen_json.py; ground truth + C reference: json_c.exe)

use stdlib.json.reader

// Sum of record ids: mirrors parser.get_int(rec, "id") with a literal
// pattern (no per-call concat).
fn extract_id(rec: Str) -> Int {
    val idx = str_index_of(rec, "\"id\":")
    if idx < 0 {
        return 0
    }
    val sub_start = idx + 5
    val rest = str_substring(rec, sub_start, str_len(rec) - sub_start)
    return str_to_int(rest)
}

// Length of the "name" string value: mirrors parser.get_string + str_len.
fn extract_name_len(rec: Str) -> Int {
    val idx = str_index_of(rec, "\"name\":\"")
    if idx < 0 {
        return 0
    }
    val sub_start = idx + 8
    val rest = str_substring(rec, sub_start, str_len(rec) - sub_start)
    val q = str_index_of(rest, "\"")
    if q < 0 {
        return 0
    }
    return q
}

fn main() {
    unsafe(justification: "bench_json: read the generated 10 MB workload") {
        val text = read_file("bench_json/data_10mb.json")
        if str_len(text) == 0 {
            out "READ_FAIL"
            return
        }

        // ---- Phase 1: full validation ----
        val t0 = now_ms()
        val rc = json_validate(text)
        val t1 = now_ms()
        if rc < 0 {
            out fmt"VALIDATE_FAIL {json_error_text(rc)}"
            return
        }

        // ---- Phase 2: per-record extraction ----
        val b = str_bytes(text)
        val n = b.len()
        mut sum_ids = 0
        mut sum_name = 0
        mut records = 0
        mut depth = 0
        mut rec_start = 0
        mut i = 0
        while i < n {
            val c = b.get(i)
            if c == 123 {
                // '{': a record object starts at array depth 1
                if depth == 1 {
                    rec_start = i
                }
                depth = depth + 1
            } else if c == 125 {
                depth = depth - 1
                if depth == 1 {
                    val rec = str_substring(text, rec_start, i + 1 - rec_start)
                    sum_ids = sum_ids + extract_id(rec)
                    sum_name = sum_name + extract_name_len(rec)
                    records = records + 1
                }
            } else if c == 91 {
                depth = depth + 1
            } else if c == 93 {
                depth = depth - 1
            } else if c == 34 {
                // skip string content so braces inside strings don't count
                i = i + 1
                while i < n && b.get(i) != 34 {
                    if b.get(i) == 92 {
                        i = i + 1
                    }
                    i = i + 1
                }
            }
            i = i + 1
        }
        val t2 = now_ms()

        out fmt"RECORDS {records}"
        out fmt"SUM_IDS {sum_ids}"
        out fmt"SUM_NAME_LEN {sum_name}"
        out fmt"VALIDATE_MS {t1 - t0}"
        out fmt"EXTRACT_MS {t2 - t1}"
    }
}
