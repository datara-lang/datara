// Datara Language Sample: Post-OOP Data Class with Inherent Methods
struct User {
    name: Str
    age: Int
    role: Str
}

behavior User {
    display() -> Str => fmt"User({name}, age: {age}, role: {role})"

    is_adult() -> Bool {
        return age >= 18
    }
}

fn main() {
    let user = User { name: "Alice", age: 24, role: "Engineer" }
    out user.display()
    if user.is_adult() {
        out("Access granted: adult privileges enabled.")
    }
}
