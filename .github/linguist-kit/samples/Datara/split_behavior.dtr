// Datara Language Sample: Data-Oriented Separation of State and Behavior
struct User {
    name: Str
    age: Int
    role: Str
}

behavior User {
    greet() -> Str => fmt"Hello, {this.name} (age: {this.age}, role: {this.role})!"
}

fn main() {
    let user = User { name: "Maria", age: 25, role: "Systems Architect" }
    out user.greet()
}
