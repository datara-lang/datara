struct BoxS { xs: List<Float> }
struct BoxW { count: Int, inner: BoxS }
fn make(n: Int) -> BoxW {
    val xs: List<Float> = []
    mut i = 0
    while i < n {
        xs.append(str_to_float(int_to_str(i)))
        i = i + 1
    }
    return BoxW { count: n, inner: BoxS { xs: xs } }
}
fn bump(w: BoxW) -> BoxW {
    val nxs: List<Float> = []
    mut i = 0
    while i < w.count {
        nxs.append(w.inner.xs[i] + 0.5)
        i = i + 1
    }
    return BoxW { count: w.count, inner: BoxS { xs: nxs } }
}
fn main() {
    mut n = 4
    val w = make(n)
    out float_to_str(w.inner.xs[0])
    val w2 = bump(w)
    out float_to_str(w2.inner.xs[0])
    out int_to_str(w2.count)
    out "ONE-CALL-OK"
}
