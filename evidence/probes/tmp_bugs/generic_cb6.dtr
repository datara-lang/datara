fn iter_map<T, U>(items: List<T>, f: U) -> List<U> {
    mut res = []
    for x in items {
        res.push(f(x))
    }
    return res
}
fn main() {
    val lened = iter_map(["aa", "bbbb"], w => w.len())
    out int_to_str(lened[0])
    out int_to_str(lened[1])
    val doubled = iter_map([1, 2, 3], x => x * 2)
    out int_to_str(doubled[0])
}
