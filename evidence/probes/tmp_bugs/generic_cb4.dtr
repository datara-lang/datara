fn iter_fold<T, A, F>(items: List<T>, init: A, f: F) -> A {
    mut acc = init
    mut i = 0
    val n = items.len()
    while i < n {
        acc = f(acc, items.get(i))
        i = i + 1
    }
    return acc
}
fn main() {
    val total = iter_fold([1, 2, 3], 0, (acc, x) => acc + x)
    out int_to_str(total)
}
