fn f(p: Str) -> Outcome<Int> {
    return parse(p)?
}
fn parse(s: Str) -> Outcome<Int> {
    if s == "ok" { return Outcome.ok(7) }
    return Outcome.err("bad")
}
fn g(l: List<Outcome<Int>>) -> Outcome<Int> {
    return l[0]?
}
fn main() {
    val l = [Outcome.ok(42)]
    val a = f("ok")
    out fmt"value a={a.value}"
    val b = g(l)
    out fmt"value b={b.value}"
}
