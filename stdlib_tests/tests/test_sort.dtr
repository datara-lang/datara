use stdlib.collections.sort

@test
fn sort_stable_sorts_and_keeps_source() {
    val src = [5, 1, 4, 1, 3, 9, 2]
    val sorted = sort_stable(src)
    assert(sorted.len() == 7, "stable sort preserves length")
    assert(sorted.get(0) == 1, "minimum first")
    assert(sorted.get(6) == 9, "maximum last")
    assert(sorted.get(2) == 2, "duplicates preserved")
    assert(src.get(0) == 5, "input list is NOT mutated by sort_stable")
}

@test
fn sort_stable_handles_degenerate_inputs() {
    assert(sort_stable([]).len() == 0, "empty list stays empty")
    assert(sort_stable([7]).get(0) == 7, "single element passes through")
    val two = sort_stable([2, 1])
    assert(two.get(0) == 1 && two.get(1) == 2, "two-element swap works")
}

@test
fn sort_unstable_sorts_a_fresh_copy() {
    val src = [9, 3, 7, 3]
    val sorted = sort_unstable(src)
    assert(is_sorted(sorted), "unstable result is ascending")
    assert(sorted.len() == 4, "length preserved")
    assert(src.get(0) == 9, "input list is NOT mutated by sort_unstable")
}

@test
fn is_sorted_detects_order() {
    assert(is_sorted([1, 2, 2, 3]), "ascending with duplicates is sorted")
    assert(!is_sorted([2, 1]), "descending pair detected")
    assert(is_sorted([]), "empty list is sorted")
    assert(is_sorted([42]), "single element is sorted")
}

@test
fn binary_search_hits_and_misses() {
    val sorted = [1, 3, 5, 7, 9, 11]
    assert(binary_search(sorted, 1) == 0, "first element found")
    assert(binary_search(sorted, 11) == 5, "last element found")
    assert(binary_search(sorted, 7) == 3, "middle element found")
    assert(binary_search(sorted, 4) == -1, "absent even value -> -1")
    assert(binary_search(sorted, 0) == -1, "below range -> -1")
    assert(binary_search(sorted, 99) == -1, "above range -> -1")
    assert(binary_search([], 1) == -1, "empty list -> -1")
}

@test
fn sort_stable_works_on_strings() {
    val words = ["pear", "apple", "fig"]
    val sorted = sort_stable(words)
    assert(sorted.get(0) == "apple", "string sort: first")
    assert(sorted.get(1) == "fig", "string sort: second")
    assert(sorted.get(2) == "pear", "string sort: third")
}
