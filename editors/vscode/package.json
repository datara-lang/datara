{
  "name": "datara-language",
  "displayName": "Datara Language Support",
  "description": "Rich syntax highlighting, language configuration, and file icons for the Datara programming language (.dtr).",
  "version": "1.4.5",
  "publisher": "datara-project",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "datara",
        "aliases": [
          "Datara",
          "datara",
          "dtr"
        ],
        "extensions": [
          ".dtr"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "datara",
        "scopeName": "source.datara",
        "path": "./syntaxes/datara.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "datara",
        "path": "./snippets/datara.json"
      }
    ],
    "iconThemes": [
      {
        "id": "datara-icons",
        "label": "Datara Icons",
        "path": "./icons/icon-theme.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Datara",
      "properties": {
        "datara.serverPath": {
          "type": "string",
          "default": "forgen",
          "description": "Path to the forgen binary (the extension runs '<path> lsp' over stdio)."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/datara-lang/datara.git"
  },
  "license": "Apache-2.0 OR MIT",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:datara"
  ]
}
