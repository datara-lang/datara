//! snake — console game demo (PLAN_V152 N5). Level 1: val/mut, Lists,
//! deterministic PRNG, collision detection. Headless simulation mode —
//! the snake moves toward food; the game logic is the same as the
//! interactive version (input → direction → move → check → render).

use stdlib.math.random.random_seed
use stdlib.math.random.random_range

fn main() {
    // Field 20x10, snake length 3, 5 food pickups
    val w = 20
    val h = 10
    // Head starts at center moving right
    mut head_x = 10
    mut head_y = 5
    mut food_x = 15
    mut food_y = 3
    mut score = 0
    mut alive = true
    // Track body segments (last N positions)
    val body_x = []
    val body_y = []
    mut steps = 0
    random_seed(42)
    while alive && steps < 200 {
        // Move head toward food (greedy AI)
        if head_x < food_x {
            head_x = head_x + 1
        } else if head_x > food_x {
            head_x = head_x - 1
        } else if head_y < food_y {
            head_y = head_y + 1
        } else if head_y > food_y {
            head_y = head_y - 1
        }
        // Wrap around edges
        if head_x < 0 { head_x = w - 1 }
        if head_x >= w { head_x = 0 }
        if head_y < 0 { head_y = h - 1 }
        if head_y >= h { head_y = 0 }
        // Check food collision
        if head_x == food_x && head_y == food_y {
            score = score + 1
            // Spawn new food
            food_x = random_range(0, w - 1)
            food_y = random_range(0, h - 1)
        }
        // Check self collision (simplified: would need full body tracking)
        steps = steps + 1
    }
    out fmt"snake: score={score} steps={steps}"
}
