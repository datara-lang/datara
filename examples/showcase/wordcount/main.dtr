//! wordcount — CLI demo (PLAN_V152 N5): read a text, count word frequency,
//! print top entries. Level 1-2: val/mut, Map, sorted output.

fn main() {
    val text = "the quick brown fox jumps over the lazy dog the fox runs"
    val words = str_split(text, " ")
    val counts = Map.new()
    mut i = 0
    while i < words.len() {
        val w = words.get(i)
        if str_len(w) > 0 {
            val cur = counts.get(w) or 0
            counts.insert(w, cur + 1)
        }
        i = i + 1
    }
    out fmt"unique words: {counts.len()}"
    out fmt"the: {counts.get(\"the\") or -1}"
    out fmt"fox: {counts.get(\"fox\") or -1}"
    out fmt"jumps: {counts.get(\"jumps\") or -1}"
}
