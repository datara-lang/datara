// Datara Rust Bridge Showcase: serde_json Parse & Serialize

extern fn json_get_string(json_str: Str, key: Str) -> Str
extern fn json_get_int(json_str: Str, key: Str) -> Int
extern fn json_create_pair(k1: Str, v1: Str, k2: Str, v2: Int) -> Str

fn main() {
    let payload = "{\"compiler\":\"forgen\",\"tests_passing\":625,\"status\":\"verified\"}"
    mut compiler_name = ""
    mut tests = 0
    mut status = ""
    mut serialized = ""
    unsafe(justification: "Rust bridge: serde_json helpers are pure Rust crate calls") {
        compiler_name = json_get_string(payload, "compiler")
        tests = json_get_int(payload, "tests_passing")
        status = json_get_string(payload, "status")
        serialized = json_create_pair("runtime", "zero-gc", "cores", 8)
    }

    out "COMPILER: " + compiler_name
    out "TESTS: " + tests
    out "STATUS: " + status
    out "SERIALIZED: " + serialized
    out "JSON_SHOWCASE_OK"
}
