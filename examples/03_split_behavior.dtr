// Datara Example 03: Separate Behavior Declaration
// Demonstrates decoupling data definitions (struct) from implementations (behavior).

struct Account {
    username: Str
    balance: Int
}

behavior Account {
    deposit(amount: Int) -> Int {
        return this.balance + amount
    }

    display() -> Str => fmt"Account '{this.username}' | Balance: {this.balance}"
}

fn main() {
    let acc = Account { username: "Maria", balance: 500 }
    out acc.display()
    let new_balance = acc.deposit(250)
    out fmt"Projected balance after deposit: {new_balance}"
}
