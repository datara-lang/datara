// Datara Example 03 (Post-OOP): Struct + Behavior Pattern
// Demonstrates canonical post-OOP data modeling:
// Contiguous flat data structs without hidden vtables or reference overhead,
// coupled with decoupled behavior blocks.

struct Counter {
    val: Int
}

behavior Counter {
    get_val() -> Int {
        return this.val
    }

    increment(step: Int) -> Int {
        return this.val + step
    }
}

fn main() {
    let c = Counter { val: 100 }
    let next_val = c.increment(25)
    println(fmt"Counter initial: {c.get_val()}")
    println(fmt"Counter incremented: {next_val}")
}
