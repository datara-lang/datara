// Datara Example 19: Comptime Adaptive Flow-Typing (SSA Register Specialization)
// Shows how dynamic variables ('val' and 'mut val') undergo compile-time flow analysis
// to eliminate boxing overhead, allocating directly to CPU registers.

fn main() {
    out "=========================================================="
    out "  DATARA v1.3.0: COMPTIME ADAPTIVE FLOW-TYPING DEMO       "
    out "=========================================================="

    // Flow segment 1: Compiler infers Int -> promotes to hardware register
    mut val dynamic_reg = 250
    out fmt"Register state 1 (Int):     {dynamic_reg}"

    // Flow segment 2: In-place SSA rebinding with zero heap allocation
    dynamic_reg = dynamic_reg * 4
    out fmt"Register state 2 (Scales):  {dynamic_reg}"

    // Flow segment 3: Type transformation analyzed statically
    dynamic_reg = "Dynamic string specialization"
    out fmt"Register state 3 (Str):     {dynamic_reg}"

    out "=========================================================="
    out "Adaptive flow-typing achieves C-like execution speed."
}
