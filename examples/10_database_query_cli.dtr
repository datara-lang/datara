// ============================================================================
// CLI UTILITY 3: Embedded applicant database (In-Memory Database Engine)
// Demonstrates: relational structures, filtering, aggregation and table formatting
// ============================================================================

struct Applicant {
    id: Int
    name: Str
    faculty: Str
    score: Int
}

behavior Applicant {
    admission_status() -> Str => decide {
        this.score >= 85 => "Budget (Grant)",
        this.score >= 70 => "Self-funded (Paid)",
        else => "Not admitted"
    }

    is_accepted() -> Bool {
        return this.score >= 70
    }
}

fn print_row(id: Int, name: Str, faculty: Str, score: Int, status: Str) {
    out fmt" | {id}  | {name}    | {faculty}        |  {score}  | {status}"
}

fn main() {
    out "================================================================================"
    out "           DATARA DB: ADMISSIONS OFFICE INFORMATION SYSTEM          "
    out "================================================================================"

    let a1 = Applicant { id: 101, name: "A. Smirnov", faculty: "Computer Sci.", score: 96 }
    let a2 = Applicant { id: 102, name: "M. Ivanova", faculty: "Applied Math.", score: 88 }
    let a3 = Applicant { id: 103, name: "D. Kuznetsov", faculty: "Robotics", score: 76 }
    let a4 = Applicant { id: 104, name: "E. Popova  ", faculty: "Cybersec.", score: 64 }
    let a5 = Applicant { id: 105, name: "K. Vasiliev", faculty: "AI Systems", score: 92 }

    out " +-----+--------------+----------------------+-------+-------------------------+"
    out " | ID  | Applicant    | Program              | Score | Admission Decision      |"
    out " +-----+--------------+----------------------+-------+-------------------------+"

    print_row(a1.id, a1.name, a1.faculty, a1.score, a1.admission_status())
    print_row(a2.id, a2.name, a2.faculty, a2.score, a2.admission_status())
    print_row(a3.id, a3.name, a3.faculty, a3.score, a3.admission_status())
    print_row(a4.id, a4.name, a4.faculty, a4.score, a4.admission_status())
    print_row(a5.id, a5.name, a5.faculty, a5.score, a5.admission_status())

    out " +-----+--------------+----------------------+-------+-------------------------+"

    // Aggregated statistics (SQL AVG, COUNT, MAX)
    let total_applicants = 5
    let total_score = a1.score + a2.score + a3.score + a4.score + a5.score
    let denom = total_applicants.to_float()
    require denom != 0.0
    let avg_score = (total_score.to_float()) / denom

    mut accepted_count = 0
    if a1.is_accepted() { accepted_count = accepted_count + 1 }
    if a2.is_accepted() { accepted_count = accepted_count + 1 }
    if a3.is_accepted() { accepted_count = accepted_count + 1 }
    if a4.is_accepted() { accepted_count = accepted_count + 1 }
    if a5.is_accepted() { accepted_count = accepted_count + 1 }

    let acceptance_rate = ((accepted_count.to_float()) / denom) * 100.0

    out "--------------------------------------------------------------------------------"
    out fmt"Total applications processed:       {total_applicants}"
    out fmt"Students admitted:                  {accepted_count}"
    out fmt"Acceptance rate:                    {acceptance_rate}%"
    out fmt"Average score (AVG Score):          {avg_score}"
    out "================================================================================"
    out "  SELECT/AGGREGATE query completed natively in 0.00 ms."
}