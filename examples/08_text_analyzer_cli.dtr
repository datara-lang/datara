// ============================================================================
// CLI UTILITY 1: Text analyzer and readability metrics (Text Analysis Engine)
// ============================================================================

struct TextMetrics {
    total_chars: Int
    letter_chars: Int
    word_count: Int
    sentence_count: Int
    vowel_count: Int
    consonant_count: Int
}

behavior TextMetrics {
    avg_word_length() -> Float {
        if this.word_count == 0 { return 0.0 }
        let denom = this.word_count.to_float()
        require denom != 0.0
        return (this.letter_chars.to_float()) / denom
    }

    avg_sentence_length() -> Float {
        if this.sentence_count == 0 { return 0.0 }
        let denom = this.sentence_count.to_float()
        require denom != 0.0
        return (this.word_count.to_float()) / denom
    }

    readability_index() -> Float {
        if this.word_count == 0 { return 0.0 }
        let denom = this.word_count.to_float()
        require denom != 0.0
        let l = ((this.letter_chars.to_float()) / denom) * 100.0
        let s = ((this.sentence_count.to_float()) / denom) * 100.0
        return (0.0588 * l) - (0.296 * s) - 15.8
    }

    complexity_grade(score: Float) -> Str => decide {
        score >= 12.0 => "University level (Complex)",
        score >= 9.0  => "High school (Medium complexity)",
        score >= 6.0  => "Middle school (Easy to read)",
        else => "Beginner level (Very simple)"
    }
}

fn print_progress_bar(label: Str, value: Int, max_val: Int) {
    if max_val == 0 { return }
    let width = 20
    let filled = (value * width) / max_val
    print("  " + label + " [")
    for i in 0..width {
        if i < filled {
            print("#")
        } else {
            print("-")
        }
    }
    out fmt"] {value}"
}

fn main() {
    out "================================================================="
    out "      DATARA TEXT ENGINE: STATISTICAL TEXT ANALYZER       "
    out "================================================================="

    let metrics = TextMetrics {
        total_chars: 1420,
        letter_chars: 1180,
        word_count: 185,
        sentence_count: 14,
        vowel_count: 495,
        consonant_count: 685
    }

    let avg_word = metrics.avg_word_length()
    let avg_sent = metrics.avg_sentence_length()
    let read_idx = metrics.readability_index()
    let grade = metrics.complexity_grade(read_idx)

    out fmt"Total characters:               {metrics.total_chars}"
    out fmt"Letter characters:              {metrics.letter_chars}"
    out fmt"Words in document:              {metrics.word_count}"
    out fmt"Sentences:                      {metrics.sentence_count}"
    out "-----------------------------------------------------------------"
    out fmt"Average word length:            {avg_word} characters"
    out fmt"Average sentence length:        {avg_sent} words"
    out fmt"Readability index (Coleman-Liau): {read_idx}"
    out fmt"Comprehension grade:            {grade}"
    out "-----------------------------------------------------------------"
    out "Phonetic distribution (Vowels vs Consonants):"
    print_progress_bar("Vowels   ", metrics.vowel_count, metrics.letter_chars)
    print_progress_bar("Consonants", metrics.consonant_count, metrics.letter_chars)
    out "================================================================="
    out "  Analysis completed successfully in 0.00 ms (computed natively)."
}