// ============================================================================
// CLI-УТИЛИТА 1: Анализатор текста и метрик читаемости (Text Analysis Engine)
// ============================================================================

struct TextMetrics {
    total_chars: Int
    letter_chars: Int
    word_count: Int
    sentence_count: Int
    vowel_count: Int
    consonant_count: Int
}

behavior TextMetrics {
    avg_word_length() -> Float {
        if this.word_count == 0 { return 0.0 }
        let denom = this.word_count * 1.0
        require denom != 0.0
        return (this.letter_chars * 1.0) / denom
    }

    avg_sentence_length() -> Float {
        if this.sentence_count == 0 { return 0.0 }
        let denom = this.sentence_count * 1.0
        require denom != 0.0
        return (this.word_count * 1.0) / denom
    }

    readability_index() -> Float {
        if this.word_count == 0 { return 0.0 }
        let denom = this.word_count * 1.0
        require denom != 0.0
        let l = ((this.letter_chars * 1.0) / denom) * 100.0
        let s = ((this.sentence_count * 1.0) / denom) * 100.0
        return (0.0588 * l) - (0.296 * s) - 15.8
    }

    complexity_grade(score: Float) -> Str => decide {
        score >= 12.0 => "Университетский уровень (Сложный)",
        score >= 9.0  => "Старшая школа (Средняя сложность)",
        score >= 6.0  => "Средняя школа (Легко читается)",
        else => "Начальный уровень (Очень просто)"
    }
}

fn print_progress_bar(label: Str, value: Int, max_val: Int) {
    if max_val == 0 { return }
    let width = 20
    let filled = (value * width) / max_val
    print("  " + label + " [")
    for i in 0..width {
        if i < filled {
            print("#")
        } else {
            print("-")
        }
    }
    out fmt"] {value}"
}

fn main() {
    out "================================================================="
    out "      DATARA TEXT ENGINE: СТАТИСТИЧЕСКИЙ АНАЛИЗАТОР ТЕКСТА       "
    out "================================================================="

    let metrics = TextMetrics {
        total_chars: 1420,
        letter_chars: 1180,
        word_count: 185,
        sentence_count: 14,
        vowel_count: 495,
        consonant_count: 685
    }

    let avg_word = metrics.avg_word_length()
    let avg_sent = metrics.avg_sentence_length()
    let read_idx = metrics.readability_index()
    let grade = metrics.complexity_grade(read_idx)

    out fmt"Общее количество символов:       {metrics.total_chars}"
    out fmt"Количество буквенных символов:    {metrics.letter_chars}"
    out fmt"Количество слов в документе:      {metrics.word_count}"
    out fmt"Количество предложений:           {metrics.sentence_count}"
    out "-----------------------------------------------------------------"
    out fmt"Средняя длина слова:              {avg_word} символов"
    out fmt"Средняя длина предложения:        {avg_sent} слов"
    out fmt"Индекс читаемости (Coleman-Liau): {read_idx}"
    out fmt"Оценка сложности восприятия:      {grade}"
    out "-----------------------------------------------------------------"
    out "Фонетическое распределение (Гласные vs Согласные):"
    print_progress_bar("Гласные  ", metrics.vowel_count, metrics.letter_chars)
    print_progress_bar("Согласные", metrics.consonant_count, metrics.letter_chars)
    out "================================================================="
    out "  Анализ завершен успешно за 0.00 мс (Вычислено нативно)."
}