// Datara Example 15: Universal Polyglot Engine - Lua / LuaJIT Scripting
// Demonstrates embedding hot-reloadable Lua scripts inside high-performance Datara systems.

fn main() {
    out "=========================================================="
    out "  DATARA v1.3.0 POLYGLOT SHOWCASE: LUA / LUAJIT SCRIPTING "
    out "=========================================================="

    // 1. Evaluate Lua expressions
    let exp_res = lua_eval_int("2^10")
    out fmt"Lua Expression Eval ('2^10'):         {exp_res}"

    let chained_res = lua_eval_int("100 * 5 + 23")
    out fmt"Lua Expression ('100 * 5 + 23'):      {chained_res}"

    // 2. Execute Lua script
    let script = "local x = 42; return x"
    let status = lua_exec(script)
    out fmt"Lua Script Execution Status:           {status}"

    let total = exp_res + chained_res + status
    out fmt"Combined Lua Output:                  {total}"
    out "=========================================================="
    out "LuaJIT scripts execute synchronously with zero IPC latency."
}
