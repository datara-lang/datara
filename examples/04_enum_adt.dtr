enum Shape {
    Circle(Float),
    Rect(Float, Float),
    Point,
}

fn describe(s: Shape) -> Str {
    match s {
        Shape.Circle(r) => "Circle",
        Shape.Rect(w, h) => "Rectangle",
        Shape.Point => "Point",
        _ => "Unknown",
    }
}

fn main() {
    let c = Shape.Circle(10.5)
    let r = Shape.Rect(20.0, 30.0)
    let p = Shape.Point

    out fmt"Shape 1: {describe(c)}"
    out fmt"Shape 2: {describe(r)}"
    out fmt"Shape 3: {describe(p)}"
}
