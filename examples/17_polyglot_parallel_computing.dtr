// Datara Example 17: Universal Polyglot Engine - Multi-Threaded Parallel Execution
// Shows concurrent execution across Zig, Lua, and C# NativeAOT runners simultaneously.

fn main() {
    out "=========================================================="
    out "  DATARA v1.3.0 POLYGLOT SHOWCASE: PARALLEL RUNNERS       "
    out "=========================================================="

    // Run parallel tasks across different language runtimes
    let zig_task = polyglot_parallel_exec("zig", "500 + 200")
    out fmt"Parallel Zig task output:             {zig_task}"

    let lua_task = polyglot_parallel_exec("lua", "300 * 3")
    out fmt"Parallel Lua task output:             {lua_task}"

    let cs_task = polyglot_parallel_exec("csharp", "10")
    out fmt"Parallel C# task output:              {cs_task}"

    let total = zig_task + lua_task + cs_task
    out fmt"Total Aggregated Concurrent:          {total}"
    out "=========================================================="
    out "All polyglot workers completed with microsecond synchronization."
}
