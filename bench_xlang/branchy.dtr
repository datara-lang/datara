fn heavy(acc: Int, i: Int) -> Int {
    mut h = acc
    mut k = 0
    while k < 16 {
        h = h + ((i ^ k) & 63)
        k = k + 1
    }
    return h
}

fn main() -> Int {
    mut acc = 0
    mut i = 0
    while i < 50000000 {
        if (i & 1023) == 0 {
            acc = heavy(acc, i)
        } else {
            acc = acc + 1
        }
        i = i + 1
    }
    print(int_to_str(acc))
    return 0
}
